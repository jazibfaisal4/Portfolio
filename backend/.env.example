# Copy to .env (never commit .env)
APP_ENV=development

# AI provider: gemini or groq. Both have free tiers; get a key from Google AI Studio or Groq.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Pick a current Flash-class (Gemini) or fast (Groq) model from the provider's model list.
# Left empty on purpose: without it the assistant answers from the knowledge notes only.
AI_MODEL=
MAX_OUTPUT_TOKENS=800

# Contact form (Resend). Free tier; check Resend docs for sending to your own inbox without a domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
PUBLIC_EMAIL=jazibfaisal66@gmail.com

# Comma-separated list of frontend origins allowed to call the API directly
ALLOWED_ORIGINS=http://localhost:3000
GITHUB_USERNAME=jazibfaisal4

CHAT_PER_MIN_PER_IP=10
CHAT_PER_MIN_GLOBAL=60
CONTACT_PER_HOUR_PER_IP=5
TRUST_PROXY=1
